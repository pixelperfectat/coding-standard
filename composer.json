{
    "name": "pixelperfectat/coding-standard",
    "description": "PixelPerfect shared Magento module coding standard: phpcs ruleset (extends Magento2), phpstan config, and the pinned QA toolchain.",
    "type": "phpcodesniffer-standard",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "bitexpert/phpstan-magento": "^0.44.0",
        "captainhook/captainhook": "^5.29",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "ergebnis/composer-normalize": "^2.42",
        "magento/magento-coding-standard": "^41",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "bin": [
        "bin/check-module-boundaries.php",
        "bin/check-xml-class-refs.php",
        "bin/check-framework-internals.php"
    ]
}
